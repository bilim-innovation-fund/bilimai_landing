# Адрес основного приложения без завершающего слеша. Он же цель авторедиректа
# залогиненных. Если не задан, используется зашитый в код прод-фолбэк
# https://app.bilimai.kz.
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Публичный endpoint списка ожидания из Swagger.
NEXT_PUBLIC_WAITLIST_API_URL=https://api.dev.bilimai.kz/api/v1/auth/waitlist/

# Сервер BilimAI API для браузерной проверки сессии (без завершающего слеша).
# Если не задан, используется зашитый в код прод-фолбэк https://api.app.bilimai.kz
# (env сервера лендинга не под нашим контролем). Задавайте только для дев-стенда,
# вместе с NEXT_PUBLIC_APP_URL — иначе проверка и редирект уйдут в разные окружения.
NEXT_PUBLIC_API_ORIGIN=https://api.dev.bilimai.kz

# Сервер BilimAI API без завершающего слеша.
API_PROXY_TARGET=https://api.dev.bilimai.kz


# Необязательный полный адрес endpoint списка ожидания.
# Если не задан, используется API_PROXY_TARGET + /api/v1/auth/waitlist/.
WAITLIST_API_URL=
